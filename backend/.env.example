# Red5 Studio backend environment variables.
#
# Copy this file to `.env` (same folder) and fill in real values.
# The real `.env` is git-ignored and must NEVER be committed.
#
# RED5_MASTER_KEY: engineer/config recovery password + admin login (username: admin).
# Verified server-side only — never embedded in the browser.
RED5_MASTER_KEY=changeme

# Studio auth state (optional). Default: /root/.red5 or DATA_ROOT/.red5
# STUDIO_AUTH_STATE_DIR=/var/lib/red5/.red5

# Set COOKIE_SECURE=false for local HTTP dev without TLS.
# COOKIE_SECURE=true

# Filesystem roots on the Linux controller/server (leave as-is unless yours differ).
# DATA_ROOT=/root/data
# SCRIPTS_ROOT=/root/scripts

# Frontend origin for CORS (only needed if you serve the UI from a different host).
# FRONTEND_ORIGIN=https://your-domain.example
